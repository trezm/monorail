load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_rust//rust:defs.bzl", "rust_clippy", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# crate_universe resolves third-party crates from these.
exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "clippy.toml",
])

# npm_translate_lock reads these the way crate_universe reads the Cargo
# manifests.
exports_files([
    ".bazelignore",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

# The lockfile lives here, so the links into the pnpm store are declared
# here too, even though the root package itself has no dependencies.
npm_link_all_packages()

# `bazel build //:clippy` lints every Rust target in the repo.
rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        "//api:api",
        "//api:integration_tests",
        "//api:migrate",
        "//api:monorail-api",
        "//api:unit_tests",
    ],
)

# `bazel test //:rustfmt` fails on unformatted code; `bazel run
# @rules_rust//tools/rustfmt` rewrites it.
rustfmt_test(
    name = "rustfmt",
    size = "small",
    targets = [
        "//api:api",
        "//api:migrate",
        "//api:monorail-api",
    ],
)
