# Copy to .env for local development with `pnpm dev`. The default matches the
# API's own development default, so a local checkout needs no configuration.
#
# Bazel does not read this file: an undeclared file is absent from the sandbox.
# `bazel build //ui` takes --define=PUBLIC_API_URL=... instead, and //.bazelrc
# holds the development default. See README.md.
#
# PUBLIC_ is Astro's prefix for values that reach the browser. This one does:
# the login button is a link to the API, so the URL has to be in the page.
PUBLIC_API_URL=http://localhost:8080
