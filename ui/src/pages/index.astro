---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

import App from '../components/App.tsx';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Your Railway projects on one track: services, deployments and autoscaling."
    />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9fd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d0a15" />
    <title>monorail</title>
  </head>
  <body>
    <App client:load />
  </body>
</html>
