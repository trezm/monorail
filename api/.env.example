# Copy to .env for local development. Every value here is the built-in default,
# so the service also runs with no .env at all.
#
# .env is read only by the binary (via dotenvy), never by tests.

# staging | production. Anything else, including unset, is development.
API_ENV=development

# Bind address. 0.0.0.0 accepts external connections; 127.0.0.1 is local-only.
API_HOST=0.0.0.0
API_PORT=8080

# tracing-subscriber EnvFilter directive.
API_LOG_FILTER=info,tower_http=debug,monorail_api=debug

# pretty | json. Defaults to pretty in development, json elsewhere.
API_LOG_FORMAT=pretty

# Per-request budget before the server answers 408.
API_REQUEST_TIMEOUT_SECS=30

# Maximum request body size, in bytes.
API_BODY_LIMIT_BYTES=2097152

# Empty disables CORS. `*` allows any origin. Otherwise a comma-separated
# allow-list, e.g. https://app.example.com,https://admin.example.com
API_CORS_ALLOWED_ORIGINS=
