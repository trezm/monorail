# Copy to api/.env for local development. Every value here is the built-in
# default except the Railway OAuth credentials, which have none and must be set.
#
# The file is read only by the binaries (via dotenvy), never by tests. It is
# always this directory's, whatever directory the process was started from, and
# a variable already set in the environment wins over it.

# staging | production. Anything else, including unset, is development.
API_ENV=development

# Bind address. 0.0.0.0 accepts external connections; 127.0.0.1 is local-only.
API_HOST=0.0.0.0
API_PORT=8080

# tracing-subscriber EnvFilter directive.
API_LOG_FILTER=info,tower_http=debug,monorail_api=debug

# pretty | json. Defaults to pretty in development, json elsewhere.
API_LOG_FORMAT=pretty

# Per-request budget before the server answers 408.
API_REQUEST_TIMEOUT_SECS=30

# Maximum request body size, in bytes.
API_BODY_LIMIT_BYTES=2097152

# Empty disables CORS. `*` allows any origin. Otherwise a comma-separated
# allow-list, e.g. https://app.example.com,https://admin.example.com
#
# Only an explicit list allows credentials, so a browser UI on another
# origin needs one to send its session cookie -- `*` will not do. The value
# below is the Astro dev server in //ui, which is what a local checkout runs
# and what the dashboard needs to read /api/v1/projects at all.
API_CORS_ALLOWED_ORIGINS=http://localhost:4321

# --- Database ---------------------------------------------------------------
#
# Unprefixed DATABASE_URL is also honored — that is the name diesel-cli and most
# hosted Postgres providers use — and loses to API_DATABASE_URL.
#
# The value below is the development default and matches //compose.yaml, so a
# local checkout needs no database configuration at all. Staging and production
# have no default: an unset variable there is a startup error rather than a
# service quietly dialling localhost.
API_DATABASE_URL=postgres://monorail:monorail@localhost:5432/monorail

# Maximum Postgres connections held by this process. Multiply by the replica
# count and keep the result under the server's max_connections (100 by default).
API_DATABASE_POOL_SIZE=10

# How long a request waits for a pooled connection, including the time to open
# a new one, before it gives up and the response is a 503.
API_DATABASE_CONNECT_TIMEOUT_SECS=5

# --- Railway OAuth ----------------------------------------------------------
#
# The three settings below are required and the server will not start without
# them. `//api:migrate` does not read them. Create an app under Railway
# workspace settings -> Developer -> New OAuth App; the secret is shown once.
#
# API_RAILWAY_REDIRECT_URI must byte-for-byte match a redirect URI registered
# on that app.
API_RAILWAY_CLIENT_ID=
API_RAILWAY_CLIENT_SECRET=
API_RAILWAY_REDIRECT_URI=http://localhost:8080/auth/railway/callback

# Space- or comma-separated. `openid` is required and its absence is a startup
# error. `project:member` and `workspace:member` are what let the resulting
# token act on Railway resources, at the cost of a wider consent screen; drop
# them to `openid email profile` for a login-only app.
API_RAILWAY_SCOPES=openid email profile project:member workspace:member

# The provider itself. Only worth changing to point a test at a local server.
API_RAILWAY_ISSUER=https://backboard.railway.com

# Wall-clock budget for one call to Railway.
API_RAILWAY_TIMEOUT_SECS=10

# --- Sessions ---------------------------------------------------------------
#
# How long a login lasts. Enforced against the stored session, not the cookie's
# Max-Age, which the client controls.
API_SESSION_TTL_SECS=1209600

# Where a completed login sends the browser. The default is the Astro dev
# server in //ui.
API_AUTH_SUCCESS_REDIRECT=http://localhost:4321/

# --- Autoscaling ------------------------------------------------------------
#
# Whether this process runs the horizontal autoscaling loop. Turn it off when
# the loop runs as its own service, or not at all.
API_AUTOSCALER_ENABLED=true

# How often the loop looks for rules whose poll frequency has elapsed. The
# floor on reaction time; each rule brings its own frequency.
API_AUTOSCALER_TICK_SECS=30

