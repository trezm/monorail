{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "api/Dockerfile",
    "watchPatterns": ["api/**", "Cargo.toml", "Cargo.lock"]
  },
  "deploy": {
    "preDeployCommand": "/app/migrate",
    "healthcheckPath": "/health/ready"
  }
}
