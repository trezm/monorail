# direnv (https://direnv.net) — optional. `direnv allow` once per worktree.
#
# Bazel is the build system and needs nothing here. This exists only for the
# cargo escape hatch (rust-analyzer, `cargo test`): without it, every worktree
# grows its own multi-gigabyte target/ directory.
#
# Trade-off: worktrees share one target dir, so concurrent `cargo` invocations
# serialize on cargo's lock. They stay correct — just not parallel.
export CARGO_TARGET_DIR="${HOME}/.cache/monorail/cargo-target"
