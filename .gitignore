# Bazel convenience symlinks into this worktree's output base.
/bazel-*

# Machine-specific Bazel settings (see the "Local overrides" block in .bazelrc).
.bazelrc.user

# Generated by `bazel run @rules_rust//tools/rust_analyzer:gen_rust_project`.
# Both contain absolute paths into this machine's output base.
/rust-project.json
/.rules_rust_analyzer/

# Cargo output. Should be empty when CARGO_TARGET_DIR is set (see .envrc);
# ignored anyway so a stray build cannot be committed.
/target
**/*.rs.bk

# Environment / secrets
.env
.env.*
!.env.example

# direnv
.direnv/

# Editors
.idea/
.vscode/
*.swp

# macOS
.DS_Store
